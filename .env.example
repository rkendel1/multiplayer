# Production settings for Multiplayer. Copy to .env.local (never commit it) and fill in.
# Development needs none of these: e-mail is printed by `feltkit dev`, and a secret is generated locally.

# 32+ random bytes, the same on every process: openssl rand -base64 32
FELTKIT_AUTH_SECRET=

# The https URL people open the app at (e-mailed sign-in and invitation links point here).
FELTKIT_PUBLIC_URL=https://multiplayer.example.com

# Account e-mail (sign-in links, verification, invitations) through your Mailerport service.
MAILPORT_URL=
MAILPORT_API_KEY=

# PersonalOS (@personalos): where PersonalOS runs, and the bridge session it issued for this app
# (in PersonalOS: npx feltkit session create --type service --id multiplayer --role bridge).
# The token holds only interactions.receive there; it is a FeltKit credential (personalos-bridge),
# used only by the declared `personalos` integration. Prefer `feltkit credential set personalos-bridge`.
# The events secret verifies PersonalOS's signed interaction.updated deliveries (personalos-events).
# Which installation this is (part of every person's external identity in Resolver): keep it stable.
PERSONALOS_URL=
FELTKIT_CREDENTIAL_PERSONALOS_BRIDGE=
FELTKIT_CREDENTIAL_PERSONALOS_EVENTS=
MULTIPLAYER_INSTANCE=multiplayer.example.com
